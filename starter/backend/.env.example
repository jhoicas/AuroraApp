# AuroraApp — Backend (local o docker compose en EC2)
# Copia:  cp .env.example .env

# --- Base de datos (Supabase Cloud — producción) ---
# Obligatoria. Sin fallback: el backend aborta si no está definida.
#
# Usa la URI del pooler de Supabase (puerto 6543) o la conexión directa (5432).
# En producción incluye siempre sslmode=require:
#
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# Dónde obtenerla: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Asegúrate de habilitar la extensión `vector` (pgvector) en el proyecto para el Knowledge Graph.

DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# --- API ---
JWT_SECRET=change-me-to-a-long-random-secret
PORT=8080

# CORS (orígenes del SPA). En EC2 incluye http://<IP>:3001
# CORS_ORIGINS=http://<TU_IP_PUBLICA_EC2>:3001,http://localhost:3001

# --- IA ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
EMBEDDING_PROVIDER=mock
