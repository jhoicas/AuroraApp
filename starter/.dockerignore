frontend/package-lock.json
frontend/e2e/
frontend/playwright.config.ts
frontend/playwright-report/
frontend/test-results/

# Docker / compose local overrides
docker-compose.override.yml

# Docs / misc
docs
**/__pycache__
**/*.test
