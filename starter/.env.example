# =============================================================================
# AuroraApp — variables para docker compose (starter/)
# Copia este archivo:  cp .env.example .env
#
# Despliegue EC2 (puertos en el host):
#   Frontend  → http://<TU_IP_PUBLICA_EC2>:3001
#   Backend   → http://<TU_IP_PUBLICA_EC2>:8081
#
# Base de datos: Supabase Cloud (NO hay contenedor Postgres en este compose).
# La cadena de conexión va en backend/.env → DATABASE_URL
# =============================================================================

# --- Seguridad API (opcional aquí; preferible en backend/.env) ---
JWT_SECRET=change-me-to-a-long-random-production-secret

# --- Asistente IA (también puede definirse en backend/.env) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Frontend (build-time: se embebe en el bundle de Vite) ---
# Opción A — API expuesta directamente en el host (recomendada si el SPA llama al :8081):
VITE_API_URL=http://<TU_IP_PUBLICA_EC2>:8081/api/v1

# Opción B — same-origin: el navegador usa :3001/api y Nginx hace proxy al backend:
# VITE_API_URL=/api/v1

# --- CORS del backend (orígenes del SPA en el navegador) ---
# Sustituye <TU_IP_PUBLICA_EC2> por la IP o dominio real del EC2.
CORS_ORIGINS=http://<TU_IP_PUBLICA_EC2>:3001,http://localhost:3001,http://127.0.0.1:3001

# --- Supabase (referencia; obligatorio en backend/.env) ---
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Obtén la URI en: Supabase Dashboard → Project Settings → Database → Connection string (URI)
